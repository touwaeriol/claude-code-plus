  "claudeCodePlus.mcp.customServers": {
    "type": "array",
    "default": [],
    "items": {
      "type": "object",
      "properties": {
        "name": { 
          "type": "string",
          "description": "Server name"
        },
        "enabled": { 
          "type": "boolean", 
          "default": true,
          "description": "Whether the server is enabled"
        },
        "backends": {
          "type": "array",
          "items": { "type": "string", "enum": ["all", "claude", "codex"] },
          "default": ["all"],
          "description": "Enabled backends"
        },
        "config": {
          "type": "object",
          "properties": {
            "command": { "type": "string", "description": "Command to execute" },
            "args": { "type": "array", "items": { "type": "string" }, "description": "Command arguments" },
            "env": { "type": "object", "description": "Environment variables" },
            "url": { "type": "string", "description": "HTTP URL for HTTP-based servers" },
            "type": { "type": "string", "enum": ["stdio", "http"], "description": "Server type" }
          },
          "description": "MCP server configuration"
        },
        "instructions": { 
          "type": "string",
          "description": "Custom instructions for the server"
        },
        "timeout": { 
          "type": "number", 
          "default": 60,
          "description": "Tool timeout in seconds"
        }
      },
      "required": ["name", "config"]
    },
    "description": "Custom MCP server configurations"
  }
